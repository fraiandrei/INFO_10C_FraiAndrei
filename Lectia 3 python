print("Perimetrul =", perimetru)
print()

# 2. Pentru 95 de minute, afisati cate ore intregi si cate minute raman
minute_totale = 95
ore = minute_totale // 60
minute_ramase = minute_totale % 60

print("Ex 2:")
print(ore, "ore si", minute_ramase, "minute")
print()

