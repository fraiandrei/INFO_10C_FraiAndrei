# 4. Scrieti 3 expresii in care parantezele schimba rezultatul
exp1_fara = 2 + 3 * 4
exp1_cu = (2 + 3) * 4

exp2_fara = 10 - 5 - 2
exp2_cu = 10 - (5 - 2)

exp3_fara = 20 / 4 * 2
exp3_cu = 20 / (4 * 2)

print("Ex 4:")
print("1)", exp1_fara, "vs", exp1_cu)
print("2)", exp2_fara, "vs", exp2_cu)
print("3)", exp3_fara, "vs", exp3_cu)
print()

